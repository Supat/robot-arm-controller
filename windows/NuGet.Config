<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Delsys API packages, fetched by fetch-delsys-packages (not redistributed in this repository). -->
    <add key="delsys-local" value="packages" />
  </packageSources>
</configuration>
