<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>assist-arm</AssemblyName>
    <RootNamespace>AssistArm.Cli</RootNamespace>
    <NoWarn>$(NoWarn);NU1701;NU1603;NU1903;NU1902;MSB3246</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssistArm.Core\AssistArm.Core.csproj" />
    <ProjectReference Include="..\AssistArm.Delsys\AssistArm.Delsys.csproj" />
  </ItemGroup>

</Project>
