<Window x:Class="AssistArm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AssistArm.App"
        Title="{Binding WindowTitle}" Width="1280" Height="860" MinWidth="900" MinHeight="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:TitleConverter x:Key="EnumTitle" />
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumTitle}}" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#F4F4F6">
            <StackPanel Margin="12">

                <GroupBox Header="EMG">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding EmgKinds}" SelectedItem="{Binding EmgKind}" ItemTemplate="{StaticResource EnumItem}"
                                  IsEnabled="{Binding EmgDisconnected}" />
                        <StackPanel Visibility="{Binding IsDelsys, Converter={StaticResource Visible}}">
                            <Expander Header="Delsys API licence" Margin="0,4,0,0">
                                <StackPanel IsEnabled="{Binding CanEditLicense}">
                                    <TextBlock Text="Key" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding DelsysKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="70" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                                    <TextBlock Text="Licence" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding DelsysLicense, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                                    <Button Content="Save licence" Click="SaveLicense_Click" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding LicensePath, StringFormat=Saved outside the project folder: {0}}" />
                                </StackPanel>
                            </Expander>

                            <Button Content="{Binding BaseButtonText}" Click="Base_Click" HorizontalAlignment="Left" IsEnabled="{Binding CanToggleBase}" />
                            <TextBlock Text="{Binding BaseDetail}" Style="{StaticResource Caption}" />

                            <!-- Sensor management: everything the Trigno utilities are otherwise needed for. -->
                            <StackPanel Visibility="{Binding BaseOpen, Converter={StaticResource Visible}}" Margin="0,6,0,0">
                                <TextBlock Text="Paired sensors" FontWeight="SemiBold" />
                                <ListBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}" MaxHeight="150" Margin="0,2"
                                         DisplayMemberPath="Summary" />
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanManageSensors}">
                                    <Button Content="Rescan" Click="Rescan_Click" />
                                    <Button Content="Identify" Click="Identify_Click" Margin="6,4,0,0"
                                            ToolTip="Flash the selected sensor's light for five seconds" />
                                    <Button Content="Remove" Click="RemoveSensor_Click" Margin="6,4,0,0"
                                            ToolTip="Make the base forget the selected sensor" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Pair a new sensor as number" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="44" Text="{Binding PairNumberText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageSensors}" />
                                    <Button Content="Pair" Click="Pair_Click" Margin="6,2,0,2" IsEnabled="{Binding CanManageSensors}"
                                            Visibility="{Binding NotPairing, Converter={StaticResource Visible}}" />
                                    <Button Content="Cancel" Click="CancelPair_Click" Margin="6,2,0,2"
                                            Visibility="{Binding IsPairing, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PairStatus}" Style="{StaticResource Caption}" Foreground="#B26A00"
                                           Visibility="{Binding IsPairing, Converter={StaticResource Visible}}" />
                            </StackPanel>

                            <Grid IsEnabled="{Binding CanChooseSensors}" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Flexor sensor" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SensorNumbers}" SelectedItem="{Binding FlexorSensor}" />
                                <ComboBox Grid.Row="0" Grid.Column="2" Margin="6,2,0,2" IsEditable="True" ItemsSource="{Binding FlexorModes}"
                                          Text="{Binding FlexorMode, UpdateSourceTrigger=LostFocus}" ToolTip="Sample mode; blank keeps the sensor's current mode" />
                                <TextBlock Grid.Row="1" Text="Extensor sensor" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SensorNumbers}" SelectedItem="{Binding ExtensorSensor}" />
                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="6,2,0,2" IsEditable="True" ItemsSource="{Binding ExtensorModes}"
                                          Text="{Binding ExtensorMode, UpdateSourceTrigger=LostFocus}" ToolTip="Sample mode; blank keeps the sensor's current mode" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Sample mode on the right; leave it blank to keep the sensor's current mode. Both sensors must sample EMG at the same rate." />
                        </StackPanel>
                        <Button Content="{Binding EmgButtonText}" Click="Emg_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding EmgDetail}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Servos">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding ServoKinds}" SelectedItem="{Binding ServoKind}" ItemTemplate="{StaticResource EnumItem}"
                                  IsEnabled="{Binding ServoDisconnected}" />
                        <DockPanel Visibility="{Binding IsSerial, Converter={StaticResource Visible}}" IsEnabled="{Binding ServoDisconnected}">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                            <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshPorts_Click" Margin="6,2,0,2" />
                            <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SerialPort}" />
                        </DockPanel>
                        <Grid Visibility="{Binding IsTcp, Converter={StaticResource Visible}}" IsEnabled="{Binding ServoDisconnected}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bridge host" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding BridgeHost}" />
                            <TextBlock Grid.Column="2" Text="Port" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding BridgePort}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding ServoDisconnected}">
                            <TextBlock Text="Servo IDs   Left" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="44" Text="{Binding LeftServoId}" />
                            <TextBlock Text="Right" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                            <TextBox Width="44" Text="{Binding RightServoId}" />
                        </StackPanel>
                        <Button Content="{Binding ServoButtonText}" Click="Servo_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ServoDetail}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Activation range">
                    <StackPanel>
                        <Button Content="{Binding CalibrateText}" Click="Calibrate_Click" />
                        <TextBlock Text="{Binding RangeText}" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasRange, Converter={StaticResource Visible}}" />
                        <Button Content="Clear" Click="ClearRange_Click" HorizontalAlignment="Left" IsEnabled="{Binding NotControlling}"
                                Visibility="{Binding HasRange, Converter={StaticResource Visible}}" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Relax for a few seconds, then contract each muscle as hard as you can. The first second is ignored." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Model">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Parameters" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ModelName}" Foreground="#666666" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding NotControlling}">
                            <Button Content="Choose folder…" Click="ChooseParameters_Click" />
                            <Button Content="Use built-in" Click="BuiltInParameters_Click" Margin="6,4,0,0"
                                    Visibility="{Binding UsesCustomParameters, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelFooter}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Mode">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding StiffnessModes}" SelectedItem="{Binding StiffnessMode}" ItemTemplate="{StaticResource EnumItem}" />
                        <DockPanel Visibility="{Binding ShowThreshold, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding ThresholdText}" Style="{StaticResource FieldLabel}" Width="90" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Threshold}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </DockPanel>
                        <Expander Header="Advanced" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Angle limit (°)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AngleLimitDegrees}" />
                                <TextBlock Grid.Row="1" Text="Units per degree" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UnitsPerDegree}" />
                                <TextBlock Grid.Row="2" Text="Update rate (Hz)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UpdateRate}" />
                                <TextBlock Grid.Row="3" Text="Goal write rate (Hz)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GoalUpdateRate}" />
                                <TextBlock Grid.Row="4" Text="Max torque (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxTorquePercent}" />
                                <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Mirror right servo" IsChecked="{Binding MirrorRight}" Margin="0,4" />
                                <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Legacy stiffness scaling" IsChecked="{Binding LegacyScaling}" Margin="0,4"
                                          ToolTip="Scale normalised stiffness between the model's values at the raw calibration minimum and maximum, as the legacy demo did. Off: scale over the 0…1 activation cube." />
                            </Grid>
                        </Expander>
                        <TextBlock Text="{Binding ModeFooter}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Control">
                    <StackPanel>
                        <CheckBox Content="Record telemetry CSV" IsChecked="{Binding RecordTelemetry}" IsEnabled="{Binding NotControlling}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Plot window (s)" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PlotWindows}" SelectedItem="{Binding PlotWindow}" />
                        </DockPanel>
                        <Button x:Name="ControlButton" Content="Start control" Click="Control_Click" FontWeight="SemiBold" Padding="10,8" />
                        <Button Content="Show recordings" Click="Recordings_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ControlHint}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Log">
                    <ItemsControl ItemsSource="{Binding Log}" MaxHeight="220">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,1">
                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#999999" />
                                    <Run Text="{Binding Text, Mode=OneWay}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Foreground" Value="#555555" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Live view -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,10,16,0">
                <Ellipse x:Name="EmgDot" Width="10" Height="10" Fill="#BBBBBB" VerticalAlignment="Center" />
                <TextBlock Text="EMG" Margin="6,0,18,0" VerticalAlignment="Center" />
                <Ellipse x:Name="ServoDot" Width="10" Height="10" Fill="#BBBBBB" VerticalAlignment="Center" />
                <TextBlock Text="Servo" Margin="6,0,18,0" VerticalAlignment="Center" />
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#BBBBBB" VerticalAlignment="Center" />
                <TextBlock x:Name="StateLabel" Text="Not calibrated" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="No EMG source. Choose a source on the left and connect."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888" FontSize="15" />
            <ScrollViewer x:Name="LivePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="16,10,16,16">
                    <UniformGrid Rows="1" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Equilibrium" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ReadEquilibrium" Text="—" FontSize="18" FontWeight="Medium" />
                            <TextBlock Text=" " Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Stiffness" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ReadStiffness" Text="—" FontSize="18" FontWeight="Medium" />
                            <TextBlock Text=" " Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Compliance" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ReadCompliance" Text="—" FontSize="18" FontWeight="Medium" />
                            <TextBlock x:Name="ReadComplianceDetail" Text=" " Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Left servo" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ReadLeft" Text="—" FontSize="18" FontWeight="Medium" />
                            <TextBlock x:Name="ReadLeftDetail" Text=" " Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Right servo" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ReadRight" Text="—" FontSize="18" FontWeight="Medium" />
                            <TextBlock x:Name="ReadRightDetail" Text=" " Style="{StaticResource Caption}" />
                        </StackPanel>
                    </UniformGrid>
                    <local:PlotStrip x:Name="PlotFlexor" Height="110" Margin="0,0,0,10" Title="EMG flexor" Units="V" />
                    <local:PlotStrip x:Name="PlotExtensor" Height="110" Margin="0,0,0,10" Title="EMG extensor" Units="V" />
                    <local:PlotStrip x:Name="PlotActivation" Height="130" Margin="0,0,0,10" />
                    <local:PlotStrip x:Name="PlotAngle" Height="160" Margin="0,0,0,10" Title="Joint angle" Units="°" />
                    <local:PlotStrip x:Name="PlotStiffness" Height="120" Margin="0,0,0,10" Title="Joint stiffness" Units="0…100" />
                    <local:PlotStrip x:Name="PlotCompliance" Height="80" Title="Servo compliance" Units="slope" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
